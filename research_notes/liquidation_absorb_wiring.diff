@@ -0,0 +1,186 @@
+"""Pre-punt liquidation watch (research_notes/new_strategies_overnight.md idea 3; research_notes/liquidation_watch.md).
+
+Rivals raising cash for an election-night punt would sell their held favourites into SIG's bids in the last days. Two
+signs, both on favourite legs (outside fair >= 0.70):
+  * taker sell share: shares of taker sells / all classified taker shares on the SIG tape, our own prints excluded;
+  * gap: mean SIG mid minus the Polymarket/Kalshi fair (venue_fair polls where both venues are fresh and within 4 points),
+    in ticks, against its baseline = the median daily gap of the 3 days before.
+Trigger (all): sell share > 0.60 AND sell share >= its own baseline (median of the 3 days before) + 0.10 AND gap - baseline
+< -2 ticks (SIG sags further under the outside). Ordinary weekdays already run 56-65% taker sells on favourites, so the
+absolute 60% alone carries no information (review 24 Oct).
+
+Read-only. Run for the daily brief:  python3 -m sigbot.liquidation_watch [--days 7] [--json]
+The bot calls `trigger(conn, now)` (rolling 24 h) for the liquidation-absorb sleeve (proposals/liq_absorb.py).
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sqlite3
+import statistics as st
+import time
+from datetime import datetime, timedelta, timezone
+
+TICK = 0.005
+FAV_MIN = 0.70
+SELL_SHARE_MIN = 0.60
+SELL_SHARE_RISE = 0.10       # and at least this much above the share of the 3 days before
+MAKER_PURPOSES = ("mm", "inside", "tilt")   # our resting quotes: a rival hitting them is the flow we look for, so kept
+GAP_WIDEN_TICKS = 2.0
+BASE_DAYS = 3
+MIN_SHARES = 5000.0          # a window with less classified taker volume on favourites never triggers
+try:
+    from zoneinfo import ZoneInfo
+    ET = ZoneInfo("America/New_York")
+except Exception:                     # pragma: no cover - no tz database: fixed EDT
+    ET = timezone(timedelta(hours=-4))
+
+
+def _iso_ts(s: str) -> float:
+    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
+
+
+def fav_legs(conn, t0: float, t1: float) -> dict:
+    """exchange -> median outside fair over [t0, t1) for legs whose median fair >= FAV_MIN."""
+    vals: dict = {}
+    for ex, f in conn.execute("SELECT exchange_id, fair FROM venue_fair WHERE ts >= ? AND ts < ? AND fair IS NOT NULL "
+                              "AND exchange_id IS NOT NULL", (t0, t1)):
+        vals.setdefault(str(ex), []).append(f)
+    return {ex: st.median(v) for ex, v in vals.items() if v and st.median(v) >= FAV_MIN}
+
+
+def sell_share(conn, legs: set, t0: float, t1: float) -> tuple:
+    """(sell share, classified shares) of taker prints on `legs` in [t0, t1). Prints where we were the taker are excluded
+    (fills of non-maker purposes); rivals hitting our MM/inside/tilt quotes stay in."""
+    if not legs:
+        return None, 0.0
+    own: dict = {}
+    for ex, px, fa in conn.execute("SELECT exchange_id, price, filled_at FROM fills WHERE filled_at >= ? AND filled_at < ? "
+                                   "AND COALESCE(purpose, '') NOT IN (%s)" % ",".join("?" * len(MAKER_PURPOSES)),
+                                   (_iso(t0 - 5), _iso(t1 + 5), *MAKER_PURPOSES)):
+        try:
+            own.setdefault(str(ex), []).append((_iso_ts(fa), px))
+        except (TypeError, ValueError):
+            continue
+    buy = sell = 0.0
+    for ex, px, q, at, agg in conn.execute("SELECT exchange_id, price, quantity, executed_at, aggressor FROM tape "
+                                           "WHERE executed_at >= ? AND executed_at < ? AND aggressor IN ('buy','sell')",
+                                           (_iso(t0), _iso(t1))):
+        ex = str(ex)
+        if ex not in legs:
+            continue
+        try:
+            t = _iso_ts(at)
+        except (TypeError, ValueError):
+            continue
+        if any(abs(t - tf) < 3 and pf is not None and abs(pf - px) < 1e-6 for tf, pf in own.get(ex, ())):
+            continue                                   # our own taker print
+        if agg == "sell":
+            sell += abs(q)
+        else:
+            buy += abs(q)
+    tot = buy + sell
+    return (sell / tot if tot > 0 else None), tot
+
+
+def gap_ticks(conn, legs: set, t0: float, t1: float):
+    """Mean (SIG mid - fair) in ticks over venue_fair polls on `legs` with both venues present and within 4 points."""
+    g = []
+    for ex, pm, k, f, m in conn.execute("SELECT exchange_id, pm, kalshi, fair, sig_mid FROM venue_fair WHERE ts >= ? AND ts < ? "
+                                        "AND fair IS NOT NULL AND sig_mid IS NOT NULL", (t0, t1)):
+        if str(ex) in legs and pm is not None and k is not None and abs(pm - k) <= 0.04:
+            g.append((m - f) / TICK)
+    return (sum(g) / len(g) if g else None), len(g)
+
+
+def _iso(ts: float) -> str:
+    # the tape and fills store ISO strings ('...Z' or '+00:00'); comparing on the first 19 chars of a 'T'-separated UTC
+    # stamp is exact to the second for both forms
+    return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
+
+
+def window(conn, t0: float, t1: float, legs: dict = None) -> dict:
+    legs = fav_legs(conn, t0, t1) if legs is None else legs
+    ss, n = sell_share(conn, set(legs), t0, t1)
+    gap, ng = gap_ticks(conn, set(legs), t0, t1)
+    return {"t0": t0, "t1": t1, "legs": len(legs), "sell_share": ss, "shares": n, "gap_ticks": gap, "gap_polls": ng}
+
+
+def trigger(conn, now: float = None, span: float = 86400.0) -> tuple:
+    """(on, info) for the rolling window [now - span, now) against the median gap of the BASE_DAYS daily windows before it.
+    Legs are the favourites of the whole span so the baseline and the window compare the same legs."""
+    now = time.time() if now is None else now
+    t0 = now - span
+    legs = fav_legs(conn, t0 - BASE_DAYS * 86400, now)
+    cur = window(conn, t0, now, legs)
+    prior = [window(conn, t0 - (d + 1) * 86400, t0 - d * 86400, legs) for d in range(BASE_DAYS)]
+    base = [w["gap_ticks"] for w in prior if w["gap_ticks"] is not None]
+    bss = [w["sell_share"] for w in prior if w["sell_share"] is not None and w["shares"] >= MIN_SHARES]
+    cur["baseline_gap_ticks"] = st.median(base) if base else None
+    cur["baseline_sell_share"] = st.median(bss) if bss else None
+    cur["gap_change_ticks"] = (cur["gap_ticks"] - cur["baseline_gap_ticks"]
+                               if cur["gap_ticks"] is not None and cur["baseline_gap_ticks"] is not None else None)
+    on = (cur["sell_share"] is not None and cur["shares"] >= MIN_SHARES and cur["sell_share"] > SELL_SHARE_MIN
+          and cur["baseline_sell_share"] is not None and cur["sell_share"] >= cur["baseline_sell_share"] + SELL_SHARE_RISE
+          and cur["gap_change_ticks"] is not None and cur["gap_change_ticks"] < -GAP_WIDEN_TICKS)
+    cur["on"] = bool(on)
+    return bool(on), cur
+
+
+def leg_baselines(conn, now: float = None, days: float = BASE_DAYS, skip_recent: float = 86400.0) -> dict:
+    """exchange -> median (SIG mid - fair) in price units over [now - skip_recent - days, now - skip_recent): each leg's
+    usual gap before the trigger's 24-h window, so the sleeve buys a sag relative to the leg's own standing offset
+    (favourites sit ~6 ticks cheap on SIG anyway) and a day of liquidation cannot drag its own baseline down."""
+    end = (time.time() if now is None else now) - skip_recent
+    vals: dict = {}
+    for ex, pm, k, f, m in conn.execute("SELECT exchange_id, pm, kalshi, fair, sig_mid FROM venue_fair WHERE ts >= ? AND ts < ? "
+                                        "AND fair IS NOT NULL AND sig_mid IS NOT NULL", (end - days * 86400, end)):
+        if pm is not None and k is not None and abs(pm - k) <= 0.04:
+            vals.setdefault(str(ex), []).append(m - f)
+    return {ex: st.median(v) for ex, v in vals.items() if len(v) >= 20}
+
+
+def daily(conn, days: int = 7, now: float = None) -> list:
+    """One row per ET calendar day (America/New_York, so the 1 Nov clock change is handled), newest last, each judged like
+    trigger() at that day's end."""
+    now = time.time() if now is None else now
+    d_end = datetime.fromtimestamp(now, ET).replace(hour=0, minute=0, second=0, microsecond=0)
+    out = []
+    for k in range(days, -1, -1):
+        day = (d_end - timedelta(days=k)).replace(tzinfo=None)
+        a = day.replace(tzinfo=ET).timestamp()
+        b = min((day + timedelta(days=1)).replace(tzinfo=ET).timestamp(), now)
+        if b <= a:
+            continue
+        on, info = trigger(conn, b, span=b - a)
+        info["day"] = datetime.fromtimestamp(a, ET).strftime("%a %d %b") + ("" if b - a >= 82799 and b < now else " (so far)")
+        out.append(info)
+    return out
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--days", type=int, default=7)
+    ap.add_argument("--db", default=os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "data", "sigbot.sqlite"))
+    ap.add_argument("--json", action="store_true")
+    a = ap.parse_args(argv)
+    conn = sqlite3.connect(f"file:{a.db}?mode=ro", uri=True, timeout=20)
+    rows = daily(conn, a.days)
+    on, cur = trigger(conn)
+    if a.json:
+        print(json.dumps({"daily": rows, "rolling_24h": cur}, default=str))
+        return
+    f = lambda x, fmt: "-" if x is None else format(x, fmt)
+    print("Pre-punt liquidation watch (favourites, outside fair >= 0.70). Trigger: taker sell share > 60% and >= 10 points over"
+          " its 3-day baseline AND gap widens > 2 ticks.")
+    print(f"{'day (ET)':18s} {'legs':>4s} {'sell share':>10s} {'base':>5s} {'taker sh':>11s} {'gap t':>6s} {'base t':>6s} {'change':>6s} trigger")
+    for r in rows:
+        print(f"{r['day']:18s} {r['legs']:4d} {f(r['sell_share'], '10.0%')} {f(r['baseline_sell_share'], '5.0%')} {r['shares']:11,.0f} "
+              f"{f(r['gap_ticks'], '6.1f')} {f(r['baseline_gap_ticks'], '6.1f')} {f(r['gap_change_ticks'], '+6.1f')} {'ON' if r['on'] else 'off'}")
+    print(f"rolling 24 h: sell share {f(cur['sell_share'], '.0%')} (baseline {f(cur['baseline_sell_share'], '.0%')}) on {cur['shares']:,.0f} sh, "
+          f"gap change {f(cur['gap_change_ticks'], '+.1f')} ticks -> {'ON' if on else 'off'}")
+
+
+if __name__ == "__main__":
+    main()
