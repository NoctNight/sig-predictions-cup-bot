@@ -0,0 +1,149 @@
+"""Liquidation absorb (research_notes/new_strategies_overnight.md idea 3; research_notes/liquidation_watch.md). OFF by default.
+
+If rivals dump held favourites into SIG's bids before the 3 Nov punt, SIG's favourites sag under the outside fair by more
+than their usual offset. The sleeve buys that sag at the touch and sells it back within hours as the DMM re-centres:
+  * only while sigbot.liquidation_watch.trigger() is on (taker sell share > 60% over 24 h AND the favourite gap widened
+    > 2 ticks against the 3 days before), and only from `first_entry` (31 Oct 00:00 ET) to `last_entry`;
+  * legs: favourites (outside fair 0.70-0.97, Polymarket and Kalshi present and within 4 points), YES only, whose SIG mid
+    sits >= min_sag_ticks under (fair + the leg's own median gap of the last 3 days), with the ask still under the fair;
+  * caps: `budget` cost in total, `leg_cap` per leg, `order_notional` per order, <= 80% of the touch, a cash floor, never a
+    leg where we are short or already hold > hold_limit shares;
+  * exits (sell YES at the bid): +take_profit_ticks over the average cost, a stop at -stop_ticks, max_hold_h, the sleeve
+    kill (realised + marked P&L <= kill), and everything flat by `flat_by` (3 Nov 12:00 ET = 17:00 UTC), starting 30 min early.
+Exits and entries price off books with our own resting orders netted out (self-trade prevention); flat-by and kill exits
+fall back to a REST book, then to the cycle's bulk best bid minus 2 ticks.
+The ledger is the fills table (purposes liqabs / liqabs_exit), so a restart cannot lose a position.
+"""
+from __future__ import annotations
+
+from datetime import datetime, timezone
+from typing import Optional
+
+TICK = 0.005
+FIRST_ENTRY = datetime(2026, 10, 31, 4, 0, tzinfo=timezone.utc).timestamp()     # 31 Oct 00:00 ET
+LAST_ENTRY = datetime(2026, 11, 3, 14, 0, tzinfo=timezone.utc).timestamp()      # 3 Nov 09:00 ET (EST from 1 Nov)
+FLAT_BY = datetime(2026, 11, 3, 17, 0, tzinfo=timezone.utc).timestamp()         # 3 Nov 12:00 ET
+FLAT_WINDOW = 1800.0       # exits for flat-by start 30 min early: each attempt takes only the top of the book
+
+
+class LiqAbsorb:
+    def __init__(self, budget: float = 3000.0, leg_cap: float = 750.0, order_notional: float = 300.0, cash_floor: float = 2000.0,
+                 min_sag_ticks: float = 3.0, take_profit_ticks: float = 2.0, stop_ticks: float = 6.0, max_hold_h: float = 6.0,
+                 kill: float = -300.0, hold_limit: float = 4000.0, fair_lo: float = 0.70, fair_hi: float = 0.97,
+                 first_entry: float = FIRST_ENTRY, last_entry: float = LAST_ENTRY, flat_by: float = FLAT_BY, max_entries: int = 3):
+        self.budget, self.leg_cap, self.order_notional, self.cash_floor = budget, leg_cap, order_notional, cash_floor
+        self.min_sag, self.tp, self.stop, self.max_hold = min_sag_ticks * TICK, take_profit_ticks * TICK, stop_ticks * TICK, max_hold_h * 3600
+        self.kill, self.hold_limit, self.fair_lo, self.fair_hi = kill, hold_limit, fair_lo, fair_hi
+        self.first_entry, self.last_entry, self.flat_by, self.max_entries = first_entry, min(last_entry, flat_by - 3600), flat_by, max_entries
+
+    # ------------------------------------------------------------------ entries
+    def candidates(self, rows: list, positions: dict, base: dict, excluded_races: set = frozenset()) -> list:
+        """Favourite YES legs sagging >= min_sag under their usual gap. rows: direction rows (race, party, exchange_id, fair,
+        pm, kalshi, sig_bid, sig_ask); base: exchange -> usual (SIG mid - fair)."""
+        out = []
+        for r in rows:
+            ex = str(r.get("exchange_id") or "")
+            f, pm, k, bid, ask = r.get("fair"), r.get("pm"), r.get("kalshi"), r.get("sig_bid"), r.get("sig_ask")
+            if not ex or ex not in base or None in (f, pm, k, bid, ask) or r.get("race") in excluded_races:
+                continue
+            if not (self.fair_lo <= f <= self.fair_hi) or abs(pm - k) > 0.04 or ask <= bid:
+                continue
+            pos = positions.get(ex, 0.0)
+            if pos < 0 or abs(pos) > self.hold_limit:
+                continue                                   # short this leg (a set or another sleeve's NO), or too big already
+            mid = (bid + ask) / 2
+            sag = (mid - f) - base[ex]                      # negative = cheaper than this leg usually sits
+            if sag > -self.min_sag + 1e-9 or ask > f - TICK + 1e-9:
+                continue
+            out.append({"exchange_id": ex, "race": r.get("race"), "party": r.get("party"), "fair": f, "ask": ask, "bid": bid,
+                        "sag_ticks": sag / TICK})
+        out.sort(key=lambda c: c["sag_ticks"])
+        return out
+
+    def entries(self, cands: list, cost_by_ex: dict, deployed: float, cash: float, now: float, touch: dict, trigger_on: bool,
+                killed: bool) -> list:
+        """Orders {exchange_id, side 'yes', qty, price, notional}. touch: exchange -> (best ask, ask quantity) from a fresh book."""
+        if killed or not trigger_on or now < self.first_entry or now > self.last_entry:
+            return []
+        out = []
+        room_total = self.budget - deployed
+        for c in cands:
+            if len(out) >= self.max_entries or room_total < 1:
+                break
+            ex = c["exchange_id"]
+            if ex not in touch:
+                continue
+            px, tq = touch[ex]
+            if px is None or px <= 0 or px > c["fair"] - TICK + 1e-9 or px > c["ask"] + 1e-9:
+                continue                                   # the fresh book moved up: no longer under the fair / not the sag price
+            room = min(self.order_notional, self.leg_cap - cost_by_ex.get(ex, 0.0), room_total, cash - self.cash_floor)
+            qty = int(min(room / px, 0.8 * (tq or 0)))
+            if qty < 1:
+                continue
+            out.append({"exchange_id": ex, "race": c["race"], "side": "yes", "qty": qty, "price": round(px, 3),
+                        "notional": qty * px, "sag_ticks": c["sag_ticks"], "fair": c["fair"]})
+            room_total -= qty * px
+            cash -= qty * px
+        return out
+
+    # ------------------------------------------------------------------ exits
+    def exit_reason(self, lot: dict, bid: Optional[float], now: float, killed: bool) -> Optional[str]:
+        """lot: {qty > 0, avg, opened}. Returns why to sell now, or None."""
+        if lot["qty"] < 1:
+            return None
+        if now >= self.flat_by - FLAT_WINDOW:
+            return "flat_by"
+        if killed:
+            return "kill"
+        if bid is None:
+            return None
+        if bid >= lot["avg"] + self.tp - 1e-9:
+            return "take_profit"
+        if bid <= lot["avg"] - self.stop + 1e-9:
+            return "stop"
+        if now - lot["opened"] >= self.max_hold:
+            return "max_hold"
+        return None
+
+
+def ledger(fills: list) -> tuple:
+    """fills: rows {exchange_id, quantity, price, filled_at (epoch)} of purposes liqabs (buys, quantity > 0, YES price) and
+    liqabs_exit (sells; quantity < 0 or a NO buy recorded with YES price). Returns (lots {ex: {qty, avg, opened}},
+    cost_by_ex of open lots, deployed cost of open lots, realised P&L)."""
+    lots, realised = {}, 0.0
+    for f in fills:
+        ex, q, p, t = str(f["exchange_id"]), float(f["quantity"]), float(f["price"]), float(f.get("filled_at") or 0.0)
+        lot = lots.setdefault(ex, {"qty": 0.0, "avg": 0.0, "opened": t})
+        if q > 0:
+            if lot["qty"] <= 0:
+                lot.update(qty=0.0, avg=0.0, opened=t)
+            lot["avg"] = (lot["avg"] * lot["qty"] + p * q) / (lot["qty"] + q)
+            lot["qty"] += q
+        else:
+            n = min(-q, lot["qty"])
+            realised += n * (p - lot["avg"])
+            lot["qty"] -= n
+    lots = {ex: l for ex, l in lots.items() if l["qty"] >= 1}
+    cost = {ex: l["qty"] * l["avg"] for ex, l in lots.items()}
+    return lots, cost, sum(cost.values()), realised
+
+
+def cooled(fills: list, now: float, hours: float = 6.0, loss_ticks: float = 2.0) -> set:
+    """Legs closed at a loss of >= loss_ticks per share within the last `hours`: never re-bought (a leg that keeps falling
+    after a stop still looks like a sag). Derived from the fills, so it survives a restart."""
+    lots, out = {}, set()
+    for f in fills:
+        ex, q, p, t = str(f["exchange_id"]), float(f["quantity"]), float(f["price"]), float(f.get("filled_at") or 0.0)
+        qty, avg = lots.get(ex, (0.0, 0.0))
+        if q > 0:
+            lots[ex] = (qty + q, (avg * qty + p * q) / (qty + q)) if qty > 0 else (q, p)
+        elif qty > 0:
+            if p <= avg - loss_ticks * TICK + 1e-9 and now - t < hours * 3600:
+                out.add(ex)
+            lots[ex] = (max(qty + q, 0.0), avg)
+    return out
+
+
+def marked_pnl(lots: dict, realised: float, bids: dict) -> float:
+    """Realised plus open lots marked at the bid (a lot with no bid is marked at its cost)."""
+    return realised + sum(l["qty"] * ((bids.get(ex) if bids.get(ex) is not None else l["avg"]) - l["avg"]) for ex, l in lots.items())
