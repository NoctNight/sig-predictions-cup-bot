+_gb.mm.xv_fair = {"907": (0.13, 0.13, 0.13, 1000.0 + 27 * 3600 - 30)}    # a fresh poll 30 s ago: quote
+_g2 = R.Bot.mm_gate_ready(_gb, False, now=1000.0 + 27 * 3600)
