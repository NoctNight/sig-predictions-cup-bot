+# ================================================================================================ 7
+def t7_stamped_before_the_call():
+    seen = {}
+
+    def hook(rec):
+        if rec["kind"] == "exit":
+            seen.update(cool=dict(h.param("gap_exited") or {}), tries=dict(h.param("gap_exit_try") or {}), stops=list(h.param("gap_stops") or []))
+    h = H(rows_on=[])
