diff --git a/tests/stops_live_replay.py b/tests/stops_live_replay.py
new file mode 100644
index 0000000..cb9eaf3
--- /dev/null
+++ b/tests/stops_live_replay.py
@@ -0,0 +1,143 @@
+"""Would the per-strategy stops have paused anything on the live record? (strategy_stops.py acceptance (d))
+
+    python3 tests/stops_live_replay.py [--root DIR] [--step 300]
+
+Read-only on DIR/data/sigbot.sqlite and DIR/data/live.log. Every `step` seconds since the first fill, every strategy's
+ledger is rebuilt from the fills ingested by then (attributed as the stops do) and valued at SIG's touch at that moment
+(venue_quotes: the latest bid/ask at or before it). For each strategy: its worst fall from ANY earlier point (so whatever
+moment the stop is armed at, a loss since armed can be no larger) and its worst fall within one hour, against its limit
+and drop threshold. The markout rule is replayed on the HEALTH lines (markout30 / n), and today's switch firings are
+counted for reference. Set arb, recycles and high-frequency arb share one pooled set ledger here (churn's own ledger has
+no history), valued at settlement basis; the unattributed check needs the venue's positions per leg and is not replayed.
+"""
+from __future__ import annotations
+
+import argparse
+import bisect
+import os
+import re
+import sqlite3
+import sys
+from datetime import datetime, timezone
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.dirname(HERE))
+import sigbot.strategy_stops as ST  # noqa: E402
+
+HEALTH = re.compile(r"^(\S+ \S+),\d+ INFO sigbot: HEALTH .*markout30=(\S+?)\(n=(\d+)\)")
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--root", default=os.path.dirname(HERE))
+    ap.add_argument("--step", type=float, default=300.0)
+    a = ap.parse_args()
+    db = sqlite3.connect(f"file:{os.path.join(a.root, 'data', 'sigbot.sqlite')}?mode=ro", uri=True)
+    db.row_factory = sqlite3.Row
+
+    class Store:                                   # the read-only surface StrategyStops.ledgers() uses
+        def rows(self, q, p=()):
+            return db.execute(q, p).fetchall()
+
+        def one(self, q, p=()):
+            return db.execute(q, p).fetchone()
+    st = ST.StrategyStops(type("C", (), {})(), Store(), "/nonexistent", [], write=False)
+    fills = db.execute("SELECT ingested_at FROM fills WHERE price IS NOT NULL ORDER BY ingested_at").fetchall()
+    if not fills:
+        print("no fills")
+        return 0
+    races = {}
+    for r in db.execute("SELECT legs FROM arb_trades WHERE kind IN ('sell_set','buy_set')"):
+        try:
+            import json
+            legs = sorted({str(l["exchangeId"]) for l in json.loads(r["legs"] or "[]")})
+            if len(legs) >= 2:
+                races[tuple(legs)] = 1
+        except ValueError:
+            pass
+    st.races = [list(k) for k in races]
+    quotes = {}
+    for r in db.execute("SELECT instrument, ts, bid, ask FROM venue_quotes WHERE venue='sig' ORDER BY ts"):
+        q = quotes.setdefault(str(r["instrument"]), ([], []))
+        q[0].append(r["ts"])
+        q[1].append((r["bid"], r["ask"]))
+    t0, t1 = fills[0][0], max(fills[-1][0], max(v[0][-1] for v in quotes.values()))
+    keys = ("mm", "cheapfav", "catchup", "direction", "arb (pooled sets)")
+    series = {k: [] for k in keys}
+    real_seen = st.seen_fill
+    t = t0
+    while t <= t1 + 1:
+        st.seen_fill = real_seen
+        def _at(q, t=t):                           # the fills ingested by then (both spellings of the ledger query)
+            q = q.replace("WHERE f.price IS NOT NULL", "WHERE f.price IS NOT NULL AND f.ingested_at <= %f" % t)
+            return q.replace("WHERE price IS NOT NULL", "WHERE price IS NOT NULL AND ingested_at <= %f" % t)
+        assert "f.price IS NOT NULL" in open(ST.__file__).read()   # the substitution must keep matching the module
+        st.store = type("S", (), {"rows": lambda self, q, p=(): db.execute(_at(q), p).fetchall(),
+                                  "one": lambda self, q, p=(): db.execute(q, p).fetchone()})()
+        L, _, _ = st.ledgers()
+        touch = {}
+        for ex, (ts, ba) in quotes.items():
+            i = bisect.bisect_right(ts, t) - 1
+            if i >= 0:
+                touch[ex] = ba[i]
+        for k in ("mm", "cheapfav", "catchup", "direction"):
+            series[k].append((t, ST.touch_value(L[k], touch)))
+        series["arb (pooled sets)"].append((t, ST.touch_value(L["sets"], touch, st.races)))
+        t += a.step
+    lim = dict(ST.DEFAULT_LIMITS)
+    limit_of = {"mm": lim["mm"], "cheapfav": lim["cheapfav"], "catchup": lim["catchup"], "direction": lim["direction"],
+                "arb (pooled sets)": lim["arb"]}
+    fmt = lambda x: datetime.fromtimestamp(x, timezone.utc).strftime("%m-%d %H:%M")
+    print(f"live record {fmt(t0)} -> {fmt(t1)} UTC, every {a.step:.0f} s, {len(fills)} fills")
+    print(f"{'strategy':20s} {'limit':>7s} {'worst fall (any arm)':>22s} {'worst 1-h fall':>16s} {'drop limit':>10s}  would pause?")
+    bad = 0
+    for k in keys:
+        s = series[k]
+        peak, worst, wt = -1e18, 0.0, None
+        hw, ht = 0.0, None
+        for i, (t, v) in enumerate(s):
+            if v > peak:
+                peak = v
+            if peak - v > worst:
+                worst, wt = peak - v, t
+            j = i
+            while j > 0 and t - s[j - 1][0] <= 3600:
+                j -= 1
+            hp = max(x for _, x in s[j:i + 1])
+            if hp - v > hw:
+                hw, ht = hp - v, t
+        drop_lim = abs(limit_of[k]) if k in ST.WIDE_DROP else 400.0       # as StrategyStops (kill_drawdown 400)
+        fire = worst >= abs(limit_of[k]) or hw >= drop_lim
+        bad += fire
+        print(f"{k:20s} {limit_of[k]:7.0f} {worst:12.1f} at {fmt(wt) if wt else '-':11s} {hw:7.1f} at {fmt(ht) if ht else '-':11s}"
+              f" {drop_lim:7.0f}  {'YES' if fire else 'no'}")
+    mk, kills = [], 0
+    try:
+        for ln in open(os.path.join(a.root, "data", "live.log"), errors="replace"):
+            if "KILL SWITCH" in ln:
+                kills += 1
+            m = HEALTH.match(ln)
+            if m and m[2] != "None" and int(m[3]) >= 20 and round(float(m[2]), 6) < -1.0:
+                mk.append(m[1][:16])
+    except OSError:
+        pass
+    print(f"markout rule (MM, n >= 20, < -1): {'fires at ' + ', '.join(sorted(set(mk))[:5]) if mk else 'never fires'}")
+    pp = []
+    by = {}
+    for r in db.execute("SELECT ts, race, kind FROM arb_trades WHERE ok=1 ORDER BY ts, id"):
+        by.setdefault(r["race"], []).append((r["ts"], "unwind" if r["kind"] == "unwind_set" else "buy"))
+    for race, s in by.items():
+        for i in range(len(s)):
+            w = [k for tt, k in s if s[i][0] - 3600 < tt <= s[i][0]]
+            flips = sum(1 for x, y in zip(w, w[1:]) if x != y)
+            if flips >= ST.PINGPONG_FLIPS and w.count("unwind") >= ST.PINGPONG_UNWINDS:
+                pp.append((s[i][0], race))
+                break
+    print("ping-pong rule (>= %d alternations, >= %d unwinds in an hour): %s" % (
+        ST.PINGPONG_FLIPS, ST.PINGPONG_UNWINDS, ", ".join(f"{race} at {fmt(t_)}" for t_, race in sorted(pp)) or "never fires"))
+    print(f"today's bot-wide switch fired {kills} time(s) in live.log over the same record")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/stops_pause_check.py b/tests/stops_pause_check.py
new file mode 100644
index 0000000..0095dc5
--- /dev/null
+++ b/tests/stops_pause_check.py
@@ -0,0 +1,126 @@
+"""Paused strategies still exit, nothing else re-buys what they sell, pauses survive a restart (strategy_stops.py (c)).
+
+    python3 tests/sim_pipeline.py catchup cheapfav churn churn_restart calm --patch=tests/stops_pause_check.py
+    STOPS_PAUSE=all python3 tests/sim_pipeline.py ... --patch=tests/stops_pause_check.py      # KILL-ENTRIES instead
+
+A --patch for sim_pipeline.py. Mid-run, each sleeve is paused through params/strategy_kill.json the way the strategy
+stops write it, as soon as it holds something: high-frequency arb (churn lots), catch-up, cheap favourites, and the MM
+at cycle 20 (STOPS_PAUSE=all: every entry at once, at the first of those moments). Pause times are kept when the
+scenario builds a new Bot over the same files (churn_restart), so a pause must survive the restart. Per scenario:
+  entries after a pause (+60 s for orders in flight): must be 0
+  exits after a pause: reported (a sleeve holding something must still close it)
+  re-buys: shares bought, in the direction a paused sleeve was holding, on a leg it exited after the pause, by any
+           other order within 30 min of that exit: must be 0
+Prints PAUSECHECK lines; PAUSECHECK FAIL on a broken rule.
+"""
+import atexit
+import collections
+import json
+import logging
+import os
+import time
+
+R = mods["run"]  # noqa: F821  (sim_pipeline --patch provides mods)
+MODE = os.environ.get("STOPS_PAUSE", "each")
+ENTRY = {"mm": ("bat",), "catchup": ("cu",), "cheapfav": ("cf",)}
+EXIT = {"catchup": ("cux",), "cheapfav": ("cfx",), "mm": ("exit",), "hf_arb": ("unw",)}
+ST = {"paused": {}, "ev": [], "bot": None, "venue": None, "n": 0}
+
+
+class _H(logging.Handler):
+    def emit(self, rec):
+        m = rec.getMessage()
+        if m.startswith("CHURN enter") or m.startswith("CHURN exit") or "sets no longer held" in m:
+            ST["ev"].append((time.time(), m[:120]))
+
+
+logging.getLogger("sigbot").addHandler(_H())
+
+
+def write(name):
+    kp = os.path.join(R.HERE, "params", "strategy_kill.json")
+    try:
+        d = json.load(open(kp))
+    except Exception:
+        d = {}
+    now = time.time()
+    d[name] = {"ts": now, "utc": "sim", "reason": "sim pause (stops_pause_check)", "by": "strategy_stops", "rule": "sim"}
+    tmp = kp + ".tmp"
+    json.dump(d, open(tmp, "w"))
+    os.replace(tmp, kp)
+    ST["paused"][name] = now
+    print(f"PAUSE {name} at {time.strftime('%H:%M:%S', time.gmtime(now))}", flush=True)
+
+
+_cyc = R.Bot.cycle
+
+
+def cycle(self):
+    v = getattr(self.api, "v", None)
+    if v is not ST["venue"]:                    # a new scenario (a restart keeps the scenario's venue and its pauses)
+        report()
+        ST.update(paused={}, ev=[], n=0, venue=v)
+    if ST["bot"] is not self and ST["paused"]:
+        print(f"PAUSECHECK restart: a new Bot over the same files with {sorted(ST['paused'])} paused", flush=True)
+    ST["bot"] = self
+    _cyc(self)
+    ST["n"] += 1
+    want = []
+    if self.churn is not None and self.churn.lots:
+        want.append("hf_arb")
+    if getattr(self, "catchup_open", None):
+        want.append("catchup")
+    if getattr(self, "cheapfav_open", None):
+        want.append("cheapfav")
+    if ST["n"] >= 20:
+        want.append("mm")
+    if MODE == "all":
+        if want and "all" not in ST["paused"]:
+            write("all")
+            for k in ("hf_arb", "catchup", "cheapfav", "mm"):
+                ST["paused"][k] = ST["paused"]["all"]
+    else:
+        for k in want:
+            if k not in ST["paused"]:
+                write(k)
+
+
+R.Bot.cycle = cycle
+
+
+def report():
+    v = ST["venue"]
+    if v is None or not ST["paused"]:
+        return
+    bad = []
+    out = []
+    for k, tp in sorted(ST["paused"].items()):
+        if k == "all":
+            continue
+        if k == "hf_arb":
+            ent = [m for t, m in ST["ev"] if m.startswith("CHURN enter") and t > tp + 1]
+        else:
+            ent = [c for c in v.calls if c.get("kind") == "order" and c.get("prefix") in ENTRY.get(k, ()) and c["t"] > tp + 60]
+        ex_fills = [m for m in v.fill_meta.values() if m["prefix"] in EXIT.get(k, ()) and m["t"] > tp]
+        if k == "hf_arb":
+            n_exit = sum(1 for t, m in ST["ev"] if t > tp and (m.startswith("CHURN exit") or "no longer held" in m))
+        else:
+            n_exit = len({(m["ex"], m["t"]) for m in ex_fills})
+        rebuy = collections.Counter()
+        for f in ex_fills:
+            held_side = "no" if f["side"] == "yes" else "yes"       # an exit buying YES closed held NO, and vice versa
+            for g in v.fill_meta.values():
+                if g["ex"] == f["ex"] and g["side"] == held_side and f["t"] < g["t"] <= f["t"] + 1800 and \
+                        g["prefix"] not in EXIT.get(k, ()) and g["prefix"] not in ("seed",):
+                    rebuy[g["prefix"]] += g["qty"]
+        out.append(f"{k}: entries after pause {len(ent)}, exits after {n_exit}, re-bought by others {dict(rebuy) or 0}")
+        if ent:
+            bad.append(f"{k} entered after its pause: {ent[:2]}")
+        if rebuy:
+            bad.append(f"{k}: what it sold was bought back by {dict(rebuy)}")
+    print("PAUSECHECK", "; ".join(out), flush=True)
+    for b in bad:
+        print("PAUSECHECK FAIL", b, flush=True)
+
+
+atexit.register(report)
