+    e.fill("A", -1000, 0.6, "arb")
+    e.fill("B", -1000, 0.3, "arb")
+    e.fill("A", -200, 0.6, "mm")                                  # MM NO inventory on A
+    e.ev(dt=120)
+    e.store.record_arb("R", "unwind_set", [], 1200, 0, 0, True, {"results": [{"data": {"orderId": 7300, "exchangeId": "A"}}]})
