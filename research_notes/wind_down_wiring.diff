+                early.append(name)
+        self.early = early[0]
+        mids = [x for x in two_leg_mid_races(sim, 0.35, 0.65, exclude=tuple(self.late_sell + self.late_buy + [self.early]))]
+        self.dir_race, self.punt_race = mids[0], mids[1]
