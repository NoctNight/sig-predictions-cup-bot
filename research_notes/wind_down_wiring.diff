+            sim.chk.violation("wind_down_sold_punt", f"punt leg {self.punt_ex}: {pos.get(self.punt_ex)} held (seeded 800)")
+        by_race = collections.defaultdict(list)
+        for t, what, q, px, cost in sold:
+            if q > 1000:
